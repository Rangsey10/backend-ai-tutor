# Visual Tutor TypeScript gateway — staging/production configuration
# Copy to your deployment's secret manager; do not commit a populated .env file.
NODE_ENV=production
# APP_ENV must also be development before any local demo/fallback can activate.
APP_ENV=production
PORT=4000

# Firebase Admin service account. Keep the private key newline escapes (\n).
FIREBASE_PROJECT_ID=your-firebase-project-id
FIREBASE_CLIENT_EMAIL=firebase-adminsdk@your-firebase-project-id.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nreplace-me\n-----END PRIVATE KEY-----\n"
# Do not set FIRESTORE_EMULATOR_HOST outside local development/test.

# Private AI service URL and a unique 32+ character shared secret. This exact
# token must also be set as ai-service VISUAL_TUTOR_INTERNAL_TOKEN.
AI_SERVICE_BASE_URL=https://ai.example.com
VISUAL_TUTOR_INTERNAL_TOKEN=replace_with_a_unique_high_entropy_secret

# Comma-separated browser origins; wildcard is rejected in staging/production.
CORS_ALLOWED_ORIGINS=https://app.example.com

# Local-only flags. They remain disabled even when accidentally supplied to a
# staging/production process.
ALLOW_DEVELOPMENT_FALLBACKS=false
AI_SERVICE_USE_DEV_MOCK=false

# JWT/local auth
JWT_ACCESS_SECRET=change-me-in-production
JWT_ACCESS_TTL_MINUTES=15
JWT_REFRESH_TTL_DAYS=30
AUTH_ACTION_TOKEN_TTL_MINUTES=30
